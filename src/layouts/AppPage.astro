---
import '@fontsource-variable/inter';
import ForgeApp from '../components/ForgeApp';
import { trainingPlans } from '../data/workouts';
import '../styles/global.css';

type Props = { initialPath: string };
const { initialPath } = Astro.props;
const pagePlan =
  trainingPlans.find((plan) => initialPath.includes(`/${plan.slug}`)) ?? trainingPlans[0]!;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#0a0a0a" />
    <meta
      name="description"
      content="Plan de entrenamiento en casa para perder grasa y ganar fuerza."
    />
    <title>{pagePlan.wordmark} — Mi plan de entrenamiento</title>
  </head>
  <body>
    <ForgeApp client:load initialPath={initialPath} />
  </body>
</html>
