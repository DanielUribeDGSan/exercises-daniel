---
import AppPage from '../layouts/AppPage.astro';
import { findExercise, getExerciseSlug, trainingPlans, workouts } from '../data/workouts';

export const getStaticPaths = () => {
  const planPaths = trainingPlans.flatMap((plan) => [
    { params: { slug: plan.slug } },
    { params: { slug: `${plan.slug}/perfil` } },
    ...plan.workouts.flatMap((workout) => [
      { params: { slug: `${plan.slug}/rutinas/${workout.id}` } },
      ...workout.exerciseIds.map((exerciseId) => ({
        params: {
          slug: `${plan.slug}/rutinas/${workout.id}/ejercicios/${getExerciseSlug(findExercise(exerciseId))}`,
        },
      })),
    ]),
  ]);
  const legacyPaths = workouts.flatMap((workout) => [
    { params: { slug: `rutinas/${workout.id}` } },
    ...workout.exerciseIds.map((exerciseId) => ({
      params: {
        slug: `rutinas/${workout.id}/ejercicios/${getExerciseSlug(findExercise(exerciseId))}`,
      },
    })),
  ]);
  return [{ params: { slug: 'perfil' } }, ...legacyPaths, ...planPaths];
};
---

<AppPage initialPath={Astro.url.pathname} />
